# WebsiteLead Hunter - Production Private Mesh Caddyfile
#
# Unified HTTPS Reverse Proxy & PWA Static File Server for WebsiteLead Hunter.
# Routes /api/* to FastAPI loopback (127.0.0.1:8000) and serves compiled PWA static shell.
#
# Environment variables:
#   TAILSCALE_HOST : Private Mesh FQDN (e.g. my-host.tailnet123.ts.net)
#                    Defaults to 'localhost' for local private testing.
#   BACKEND_ADDR   : FastAPI loopback address (default: 127.0.0.1:8000)
#   FRONTEND_DIR   : Path to compiled frontend distribution directory

{$TAILSCALE_HOST:localhost} {
    # -------------------------------------------------------------------------
    # TLS Configuration
    # -------------------------------------------------------------------------
    # In production on a Tailscale node, Caddy fetches HTTPS certificates from Tailscale:
    #   tls {
    #       get_certificate tailscale
    #   }
    # For offline, air-gapped, or local development:
    tls internal

    # -------------------------------------------------------------------------
    # Hardened Security Response Headers
    # -------------------------------------------------------------------------
    header {
        # Enforce HTTPS across all subdomains
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Prevent MIME confusion attacks
        X-Content-Type-Options "nosniff"
        # Prevent frame injection & clickjacking
        X-Frame-Options "DENY"
        # Control referrer leakage
        Referrer-Policy "strict-origin-when-cross-origin"
        # Restrict content execution to same-origin
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self' data:; manifest-src 'self';"
        # Strip Caddy/server identity header
        -Server
    }

    # -------------------------------------------------------------------------
    # Backend API Reverse Proxy (/api/*)
    # -------------------------------------------------------------------------
    handle /api/* {
        reverse_proxy {$BACKEND_ADDR:127.0.0.1:8000} {
            # Strip untrusted client headers to prevent spoofing
            header_up -X-Forwarded-Server
            header_up -X-Forwarded-For
            header_up -X-Forwarded-Proto
            header_up -X-Forwarded-Host

            # Set authentic proxy forwarded headers
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
            header_up Host {host}

            # Bounded timeouts
            transport http {
                response_header_timeout 30s
                dial_timeout 5s
            }
        }
    }

    # -------------------------------------------------------------------------
    # Frontend PWA Static Shell
    # -------------------------------------------------------------------------
    handle {
        root * {$FRONTEND_DIR:../frontend/dist}

        # Cache immutable hashed Vite assets for 1 year
        @static_assets path /assets/*
        header @static_assets Cache-Control "public, max-age=31536000, immutable"

        # Service worker, manifest, and index.html must revalidate immediately
        @no_cache path /sw.js /manifest.webmanifest /index.html
        header @no_cache Cache-Control "no-cache, no-store, must-revalidate"

        # Single-Page-App fallback routing
        try_files {path} /index.html
        file_server
    }
}
