# WebsiteLead Hunter - Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Host and Port Configuration
PORT=8000
HOST=127.0.0.1

# Database Configuration
DATABASE_URL=sqlite:///./websitelead_hunter.db

# Optional AI Pitch Generation (Gemini API)
# Leave empty to use high-quality deterministic fallback templates
GEMINI_API_KEY=

# OpenStreetMap User Agent (Required by Nominatim terms of use)
OSM_USER_AGENT=WebsiteLeadHunter/1.0 (contact@websiteleadhunter.local)

# Discovery & Audit Settings
MAX_PARALLEL_AUDITS=5
HTTP_REQUEST_TIMEOUT_SECONDS=10
AUDIT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36 WebsiteAuditor/1.0
